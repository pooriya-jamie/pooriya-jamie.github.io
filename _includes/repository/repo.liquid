{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}
{% assign repo_name = repo_url[1] | replace: '-', ' ' | replace: '_', ' ' %}

<div class="repo">
  <a class="repo-card" href="https://github.com/{{ include.repository }}" aria-label="Open {{ include.repository }} on GitHub">
    <span class="repo-card__icon" aria-hidden="true">
      <i class="fa-brands fa-github"></i>
    </span>
    <span class="repo-card__content">
      <span class="repo-card__title">{{ repo_name }}</span>
      <span class="repo-card__meta">
        {% if show_owner %}
          {{ repo_url[0] }} /
        {% endif %}
        {{ repo_url[1] }}
      </span>
    </span>
  </a>
</div>
