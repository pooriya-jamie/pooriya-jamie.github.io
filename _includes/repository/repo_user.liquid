<div class="repo repo--profile">
  <a class="repo-card repo-card--profile" href="https://github.com/{{ include.username }}" aria-label="Open {{ include.username }} on GitHub">
    <span class="repo-card__icon" aria-hidden="true">
      <i class="fa-brands fa-github"></i>
    </span>
    <span class="repo-card__content">
      <span class="repo-card__title">{{ include.username }}</span>
      <span class="repo-card__meta">GitHub profile</span>
    </span>
  </a>
</div>
